{
  "name": "notediscovery-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Builds frontend/note-editor.bundle.js. Development only: the app itself needs no Node.",
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=iife --global-name=NoteEditor --outfile=../note-editor.bundle.js",
    "test": "systemd-run --user --scope --quiet -p MemoryMax=4G -p MemorySwapMax=0 node test/markdown.test.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.32.2",
    "@tiptap/extension-image": "3.32.2",
    "@tiptap/extension-list": "3.32.2",
    "@tiptap/extension-table": "3.32.2",
    "@tiptap/extensions": "3.32.2",
    "@tiptap/markdown": "3.32.2",
    "@tiptap/pm": "3.32.2",
    "@tiptap/starter-kit": "3.32.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "27.0.0"
  }
}
